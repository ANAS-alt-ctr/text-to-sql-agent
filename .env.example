# Copy this file to ".env" and fill in your own values.
# NEVER commit a real .env -- it is in .gitignore. No key belongs in code.

# --- LLM (OpenAI-compatible chat completions) ---
# OpenAI: https://api.openai.com/v1
# Any other OpenAI-compatible gateway works too (local server, Azure, etc.).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
# Hard ceiling on tokens spent in one session (input + output).
LLM_SESSION_TOKEN_BUDGET=100000
# Prices in USD per 1,000 tokens, for cost reporting only.
LLM_PRICE_INPUT_PER_1K=0.00015
LLM_PRICE_OUTPUT_PER_1K=0.0006

# --- Database ---
# SQLite (default, zero setup). For Postgres use e.g.:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/olist
DB_URL=sqlite:///./data/sample.db

# --- Safety ---
QUERY_TIMEOUT_SECONDS=30
ROW_CAP=100
MAX_RETRIES=3

# --- Logging ---
LOG_FILE=logs/steps.jsonl
